<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The apps on Home, in this order, until the owner chooses others on the TV (Settings, Home apps). Apps that are
         not installed are left out. At most six with the Today add-on (Calendar and Tasks take two rows), eight
         without. -->
    <string-array name="dock_apps" translatable="false">
        <item>com.google.android.youtube.tv</item>
        <item>com.netflix.ninja</item>
        <item>com.amazon.amazonvideo.livingroom</item>
        <item>in.startv.hotstar.dplus.tv</item>
        <item>com.apple.atve.androidtv.appletv</item>
        <item>com.spotify.tv.android</item>
    </string-array>

    <!-- Night ink (light on dark) all day. false: paper from 07:00 to 19:30 and night ink the rest of the day. -->
    <bool name="ink_night_always">true</bool>
</resources>
