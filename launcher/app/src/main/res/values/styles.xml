<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Black until InkHome paints its paper, with no window animation: Home just appears. -->
    <style name="Theme.TvHome" parent="android:Theme.Material.NoActionBar.Fullscreen">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:colorBackground">@android:color/black</item>
        <item name="android:windowAnimationStyle">@null</item>
        <!-- Opaque, said outright: on some firmware a theme comes out translucent, the TV app keeps running under
             Home, and after an HDMI input its picture stays on screen. -->
        <item name="android:windowIsTranslucent">false</item>
        <item name="android:windowIsFloating">false</item>
        <item name="android:windowSwipeToDismiss">false</item>
    </style>
</resources>
